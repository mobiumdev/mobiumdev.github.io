  "members": {
    "Connect": [
      {
        "title": "Connect to whichever device is running",
        "code": "using var dev = Device.Connect();\nConsole.WriteLine(dev.Current());"
      },
      {
        "title": "Connect to one device, with a named driver",
        "code": "using var dev = Device.Builder()\n    .OnDevice(\"emulator-5554\")\n    .Driver(\"uiautomator2\")\n    .Connect();"
      }
    ],
    "Builder": [
      {
        "title": "Configure a session before starting it",
        "code": "var builder = Device.Builder().Platform(\"ios\").App(\"com.apple.Preferences\");\nusing var dev = builder.Start();"
      }
    ],
    "Start": [
      {
        "title": "Open a session and launch the app fresh",
        "code": "using var dev = Device.Builder().Platform(\"android\").App(\"com.android.settings\").Start();\ndev.Tap(\"text=Network & internet\");"
      }
    ],
    "Binary": [
      {
        "title": "Use a mobium binary that is not on PATH",
        "code": "using var dev = Device.Builder().Binary(\"/opt/mobium/bin/mobium\").Connect();"
      }
    ],
    "OnDevice": [
      {
        "title": "Pick one of several devices",
        "code": "using var dev = Device.Builder().OnDevice(\"emulator-5554\").Connect();"
      }
    ],
    "Driver": [
      {
        "title": "Use the zero-install Android driver",
        "code": "using var dev = Device.Builder().Driver(\"uiautomator\").Connect();"
      }
    ],
    "CallTimeout": [
      {
        "title": "Bound how long any one call may take",
        "code": "using var dev = Device.Builder()\n    .CallTimeout(TimeSpan.FromMinutes(2))\n    .Connect();"
      }
    ],
    "Session": [
      {
        "title": "Name the daemon session",
        "code": "using var dev = Device.Builder().Session(\"checkout\").Connect();"
      }
    ],
    "Platform": [
      {
        "title": "Start a session on an iOS simulator",
        "code": "using var dev = Device.Builder().Platform(\"ios\").Start();"
      }
    ],
    "App": [
      {
        "title": "Launch an app as the session starts",
        "code": "using var dev = Device.Builder().App(\"com.example.shop\").Start();"
      }
    ],
    "Quit": [
      {
        "title": "End the session, putting back what it changed",
        "code": "var dev = Device.Builder().App(\"com.android.settings\").Start();\ntry { dev.Tap(\"text=Display\"); }\nfinally { dev.Quit(); }"
      }
    ],
    "Dispose": [
      {
        "title": "Let a using block quit the session",
        "code": "using (var dev = Device.Builder().App(\"com.android.settings\").Start())\n{\n    dev.Tap(\"text=Display\");\n} // quit here"
      }
    ],
    "Sessions": [
      {
        "title": "List the sessions open on the daemon",
        "code": "foreach (var s in device.Sessions())\n    Console.WriteLine($\"{s[\"device\"]} {s[\"platform\"]} {s[\"driver\"]}\");"
      }
    ],
    "Call": [
      {
        "title": "Run any tool by name",
        "code": "var result = device.Call(\"app_battery\", null);"
      },
      {
        "title": "Pass arguments the typed methods do not take",
        "code": "device.Call(\"app_sms\", new Dictionary<string, object?> { [\"text\"] = \"Hi\", [\"from\"] = \"5559876\" });"
      }
    ],
    "Step": [
      {
        "title": "Build steps for Batch",
        "code": "var step = Device.Step(\"app_tap\", new Dictionary<string, object?> { [\"target\"] = \"@e2\" });\ndevice.Batch(step, Device.Step(\"app_map\"));"
      }
    ],
    "WaitFor": [
      {
        "title": "Wait until an element is visible",
        "code": "Element? e = device.WaitFor(\"text=Welcome\");\nif (e != null) device.Tap(e.Ref);"
      }
    ],
    "ScrollTo": [
      {
        "title": "Scroll down to an element and tap it",
        "code": "var row = device.ScrollTo(\"text=About phone\");\nif (row != null) device.Tap(row.Ref);"
      }
    ],
    "Apps": [
      {
        "title": "Include the apps the platform ships",
        "code": "var all = device.Apps(true);\nConsole.WriteLine(all.Count(a => a.System));"
      }
    ],
    "MobiumException": [
      {
        "title": "Catch any failure",
        "code": "try { device.Tap(\"text=Nope\"); }\ncatch (MobiumException e)\n{\n    Console.WriteLine($\"{e.Tool} {e.Code}: {e.Message} ({e.Remedy})\");\n}"
      }
    ],
    "NoSuchElementException": [
      {
        "title": "Scroll when an element is not there",
        "code": "try { device.Tap(\"text=Continue\"); }\ncatch (NoSuchElementException) { device.ScrollTo(\"text=Continue\", \"down\"); }"
      }
    ],
    "AmbiguousLocatorException": [
      {
        "title": "Fall back to a ref when a locator matches more than one",
        "code": "try { device.Tap(\"text=OK\"); }\ncatch (AmbiguousLocatorException) { device.Tap(device.Find(\"text=OK\").First().Ref); }"
      }
    ],
    "TimedOutException": [
      {
        "title": "Tell a timeout from other failures",
        "code": "try { device.WaitFor(\"text=Done\", Until.Visible().Timeout(TimeSpan.FromSeconds(3))); }\ncatch (TimedOutException e) { Console.WriteLine(e.Retryable); }"
      }
    ],
    "UnsupportedException": [
      {
        "title": "Skip what a platform cannot do",
        "code": "try { device.Press(\"back\"); }\ncatch (UnsupportedException e) { Console.WriteLine(e.Remedy); } // iOS has no back button"
      }
    ],
    "NoSuchAlertException": [
      {
        "title": "Answer a dialog only if one is up",
        "code": "try { device.AnswerAlert(false); }\ncatch (NoSuchAlertException) { }"
      }
    ],
    "NoDeviceException": [
      {
        "title": "Report that nothing is running",
        "code": "try { device.Map(); }\ncatch (NoDeviceException e) { Console.WriteLine(e.Remedy); }"
      }
    ],
    "DeviceNotReadyException": [
      {
        "title": "Unlock before launching",
        "code": "try { device.Launch(\"com.android.settings\"); }\ncatch (DeviceNotReadyException) { device.ScreenLocked(false); device.Launch(\"com.android.settings\"); }"
      }
    ],
    "NotConfirmedException": [
      {
        "title": "Notice an action the device did not confirm",
        "code": "try { device.Check(\"@e4\"); }\ncatch (NotConfirmedException e) { Console.WriteLine(e.Details.Count); }"
      }
    ],
    "Until": [
      {
        "title": "Pass a condition to WaitFor",
        "code": "device.WaitFor(\"@e4\", Until.Text(\"Sent\").Timeout(TimeSpan.FromSeconds(30)));"
      }
    ],
    "ExactText": [
      {
        "title": "Wait for an element's whole text",
        "code": "device.WaitFor(\"testid=status\", Until.ExactText(\"Paid\"));"
      }
    ],
    "Count": [
      {
        "title": "Wait for a list to hold three rows",
        "code": "device.WaitFor(\"role=row\", Until.Count(3));"
      }
    ],
    "Not": [
      {
        "title": "Wait for a condition to stop holding",
        "code": "device.WaitFor(\"testid=submit\", Until.Enabled().Not());"
      }
    ],
    "Visible": [
      {
        "title": "Wait for an element to be on screen",
        "code": "device.WaitFor(\"text=Welcome\", Until.Visible());"
      }
    ],
    "Hidden": [
      {
        "title": "Wait for a spinner to go",
        "code": "device.WaitFor(\"role=progressbar\", Until.Hidden());"
      }
    ],
    "Text": [
      {
        "title": "Wait for text within an element",
        "code": "device.WaitFor(\"@e4\", Until.Text(\"Sent\"));"
      }
    ],
    "Value": [
      {
        "title": "Wait for a field's value",
        "code": "device.WaitFor(\"testid=email\", Until.Value(\"someone@example.com\"));"
      }
    ],
    "Enabled": [
      {
        "title": "Wait for a button to be enabled",
        "code": "var button = device.WaitFor(\"testid=submit\", Until.Enabled());"
      }
    ],
    "Disabled": [
      {
        "title": "Wait for a button to be disabled",
        "code": "device.WaitFor(\"testid=submit\", Until.Disabled());"
      }
    ],
    "Checked": [
      {
        "title": "Wait for a checkbox to be checked",
        "code": "device.WaitFor(\"testid=termsCheck\", Until.Checked());"
      }
    ],
    "Unchecked": [
      {
        "title": "Wait for a switch to be off",
        "code": "device.WaitFor(\"@e4\", Until.Unchecked());"
      }
    ],
    "Focused": [
      {
        "title": "Wait for a field to take focus",
        "code": "device.WaitFor(\"testid=search\", Until.Focused());"
      }
    ],
    "Timeout": [
      {
        "title": "Wait longer than the ten-second default",
        "code": "device.WaitFor(\"text=Ready\", Until.Visible().Timeout(TimeSpan.FromSeconds(30)));"
      }
    ],
    "AnswerAlert": [
      {
        "title": "Fill a prompt's field and accept it, in one call",
        "code": "device.AnswerAlert(true, \"Groceries\");"
      }
    ]
  },
  "intro": {
    "install": "git clone https://github.com/mobiumdev/mobium.git\ndotnet add reference mobium/clients/dotnet/Mobium/Mobium.csproj",
    "code": "using var device = Device.Builder().Platform(\"android\").App(\"com.android.settings\").Start();\nforeach (var el in device.Map()) Console.WriteLine($\"{el.Ref} {el.Label}\");",
    "note": "`device` below is a `Mobium.Device` from `Device.Builder()...Start()` or `Device.Connect()`."
  }
}
