{
  "_comment": "One scenario per example, the same on every surface: `cli` is the command, `args` the MCP arguments, and each client's examples/<lang>.json translates the scenario of the same tool and index. scripts/check_examples.py holds all three to the tool's schema and the command's flags.",
  "app_accessibility": [
    {
      "title": "Read every accessibility setting",
      "cli": "mobium accessibility",
      "args": {}
    },
    {
      "title": "Turn bold text on for the session",
      "cli": "mobium accessibility bold_text on",
      "args": {
        "setting": "bold_text",
        "value": "on"
      }
    }
  ],
  "app_alert": [
    {
      "title": "Ask whether a system dialog is up, and what it says",
      "cli": "mobium alert",
      "args": {}
    },
    {
      "title": "Answer it with the platform's accept button",
      "cli": "mobium alert accept",
      "args": {
        "action": "accept"
      }
    }
  ],
  "app_appearance": [
    {
      "title": "Switch to dark mode",
      "cli": "mobium appearance dark",
      "args": {
        "appearance": "dark"
      }
    }
  ],
  "app_background": [
    {
      "title": "Send the app away for five seconds, and bring it back",
      "cli": "mobium background 5",
      "args": {
        "seconds": 5
      }
    }
  ],
  "app_batch": [
    {
      "title": "Tap through two screens in one call",
      "cli": "mobium batch steps.json",
      "args": {
        "steps": [
          {
            "name": "app_tap",
            "arguments": {
              "target": "text=Network & internet"
            }
          },
          {
            "name": "app_wait_for",
            "arguments": {
              "target": "text=Internet"
            }
          }
        ]
      }
    }
  ],
  "app_battery": [
    {
      "title": "Read the battery",
      "cli": "mobium battery",
      "args": {}
    }
  ],
  "app_call": [
    {
      "title": "Ring the device with an incoming call",
      "cli": "mobium call --number 5551234",
      "args": {
        "number": "5551234"
      }
    },
    {
      "title": "Hang up",
      "cli": "mobium call hang",
      "args": {
        "action": "hang"
      }
    }
  ],
  "app_check": [
    {
      "title": "Tick a checkbox, whatever state it is in",
