      "args": {
        "target": "testid=termsCheck"
      }
    },
    {
      "title": "Turn a switch off",
      "cli": "mobium uncheck @e4",
      "args": {
        "target": "@e4",
        "checked": false
      }
    }
  ],
  "app_clear_data": [
    {
      "title": "Delete an app's data, and keep it installed",
      "cli": "mobium clear-data com.example.shop",
      "args": {
        "app": "com.example.shop"
      }
    }
  ],
  "app_clipboard": [
    {
      "title": "Put text on the clipboard",
      "cli": "mobium clipboard \"hello there\"",
      "args": {
        "text": "hello there"
      }
    },
    {
      "title": "Read the clipboard",
      "cli": "mobium clipboard",
      "args": {}
    }
  ],
  "app_context": [
    {
      "title": "Drive the web content of a WebView",
